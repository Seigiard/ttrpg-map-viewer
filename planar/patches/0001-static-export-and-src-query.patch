+function queryCalibration(search: string): number | undefined {
+  const params = new URLSearchParams(search);
+  const ppc = Number(params.get("ppc"));
+  const cell = /^([0-9]+(?:\.[0-9]+)?)\s*(mm|in)$/i.exec(params.get("cell") ?? "");
+  if (!Number.isFinite(ppc) || ppc <= 0 || !cell) return undefined;
+
+  const cellLength = Number(cell[1]);
+  const cellMm = cell[2].toLowerCase() === "in" ? cellLength * 25.4 : cellLength;
+
+  return Number.isFinite(cellMm) && cellMm > 0 ? ppc / cellMm : undefined;
+}
